# FirePulse Backend Environment Configuration
# NASA Space Apps Challenge 2026 - Virtual Warriors

# NASA FIRMS MAP_KEY
# Get your free key at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=YOUR_NASA_MAP_KEY

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=firepulse-dev-secret-key-virtual-warriors-2026
PORT=5000
HOST=127.0.0.1

# Database Configuration (SQLite default, replaceable with PostgreSQL)
DATABASE_URL=sqlite:///firepulse.db

# Ingestion & Processing Limits
DEFAULT_AOI_WEST=76.2
DEFAULT_AOI_SOUTH=8.0
DEFAULT_AOI_EAST=80.4
DEFAULT_AOI_NORTH=13.6
MAX_DAYS_PER_QUERY=5
FIRMS_RATE_LIMIT_DELAY_SECONDS=0.5

